# Copy to .env and fill in. Never commit the real .env (it's gitignored).
#
# Loaded by: systemd's EnvironmentFile= (deploy/*.service), or
# `set -a; source .env; set +a` before running scripts/serve.sh by hand.

# Required for any deployment reachable beyond localhost (LAN, a
# reverse proxy, etc). Leave unset for a purely local, single-user
# `streamlit run` -- Streamlit binds to localhost by default and only
# your machine can reach it.
CONTEXTGUARD_DASHBOARD_PASSWORD=

# Optional: override individual config.yaml settings without editing
# the file (handy for a container or a shared deployment). Any
# AppConfig field works as CONTEXTGUARD_<FIELD_NAME>; a few examples:
# CONTEXTGUARD_CAMERA_SOURCE=0
# CONTEXTGUARD_RISK_MODE=weighted
# CONTEXTGUARD_RETENTION_DAYS=14
# CONTEXTGUARD_LOG_LEVEL=INFO
